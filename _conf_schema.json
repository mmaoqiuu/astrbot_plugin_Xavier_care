{
  "basic": {
    "type": "object",
    "description": "关怀总览",
    "hint": "日常开关和节奏。默认值就能用。",
    "items": {
      "monitor_enabled": {
        "description": "开启主动关怀",
        "type": "bool",
        "default": true,
        "hint": "每天在合适的时候主动发一两句关心。默认开。",
        "obvious_hint": true
      },
      "care_in_chat_enabled": {
        "description": "聊天里自然关心",
        "type": "bool",
        "default": true,
        "hint": "聊天时顺带照顾她的身体状态。默认开。",
        "obvious_hint": true
      },
      "check_interval": {
        "description": "多久检查一次（秒）",
        "type": "int",
        "default": 900,
        "hint": "默认 900 秒（15 分钟）。一般不用改。"
      },
      "quiet_hours_start": {
        "description": "安静开始（几点）",
        "type": "int",
        "default": 23,
        "hint": "默认 23 点。这段时间不主动发消息。"
      },
      "quiet_hours_end": {
        "description": "安静结束（几点）",
        "type": "int",
        "default": 7,
        "hint": "默认 7 点。早上 7 点后才可能收到关心。"
      },
      "fallback_care": {
        "description": "备用一句话",
        "type": "text",
        "default": "怎么又不舒服了？过来，跟我说说。",
        "hint": "主动关怀发不出去时用这句兜底。"
      }
    }
  },
  "receive": {
    "type": "object",
    "description": "数据接收",
    "hint": "手机往哪报、密钥、推送目标。",
    "items": {
      "listen_port": {
        "description": "手机上报端口",
        "type": "int",
        "default": 8787,
        "hint": "默认 8787。被占用会自动往后换，发 /health setup 看实际地址。"
      },
      "auth_token": {
        "description": "上报密钥",
        "type": "string",
        "default": "",
        "hint": "留空即可，插件会自动生成。发 /health setup 可以直接看到。"
      },
      "push_target_umo": {
        "description": "推送到哪个私聊",
        "type": "string",
        "default": "",
        "hint": "留空会自动记住最近一次私聊。只会发私聊，不会发群。"
      },
      "retention_days": {
        "description": "数据保留天数",
        "type": "int",
        "default": 180,
        "hint": "默认保留 180 天，足够看出长期变化。"
      }
    }
  },
  "guard": {
    "type": "object",
    "description": "推送闸门",
    "hint": "觉得太勤或太安静时再动这里。",
    "items": {
      "care_guard_enabled": {
        "description": "启用推送闸门",
        "type": "bool",
        "default": true,
        "hint": "按簇冷却、每日上限、最小间隔和对话互斥节流。默认开。"
      },
      "daily_push_limit": {
        "description": "每日推送上限（条）",
        "type": "int",
        "default": 2,
        "hint": "经期关怀不占额度；填 0 表示不限。"
      },
      "min_push_interval_minutes": {
        "description": "两条关怀最小间隔（分钟）",
        "type": "int",
        "default": 180,
        "hint": "默认 180 分钟，避免刚说完又补一条。"
      },
      "dialog_guard_minutes": {
        "description": "对话互斥窗口（分钟）",
        "type": "int",
        "default": 5,
        "hint": "最近几分钟有人机往来就不插播，默认 5 分钟。"
      },
      "group_cooldown_hours_sleep": {
        "description": "睡眠类冷却（小时）",
        "type": "float",
        "default": 12.0,
        "hint": "睡太少、熬夜共用这个冷却。"
      },
      "group_cooldown_hours_fatigue": {
        "description": "疲劳类冷却（小时）",
        "type": "float",
        "default": 12.0,
        "hint": "静息心率偏高、血氧低、HRV 低共用。"
      },
      "group_cooldown_hours_night": {
        "description": "夜间实时冷却（小时）",
        "type": "float",
        "default": 2.0,
        "hint": "深夜没睡且心率偏高的即时提醒。"
      },
      "group_cooldown_hours_period": {
        "description": "经期类冷却（小时）",
        "type": "float",
        "default": 20.0,
        "hint": "经期开始、经期每日关怀共用。"
      },
      "group_cooldown_hours_forecast": {
        "description": "经期预测冷却（小时）",
        "type": "float",
        "default": 168.0,
        "hint": "默认 7 天，避免连着几天提醒。"
      },
      "group_cooldown_hours_hr": {
        "description": "心率骤升冷却（小时）",
        "type": "float",
        "default": 12.0,
        "hint": "短时间心率明显起伏的提醒。"
      }
    }
  },
  "rules": {
    "type": "object",
    "description": "异常检测规则",
    "hint": "判定阈值，不懂就保持默认。",
    "items": {
      "baseline_days": {
        "description": "基线天数",
        "type": "int",
        "default": 7,
        "hint": "用过去多少天算正常均值；历史不足 3 天不触发基线类规则。"
      },
      "rule_resting_hr_high": {
        "description": "检测静息心率偏高",
        "type": "bool",
        "default": true,
        "hint": "需要基线。默认开。"
      },
      "resting_hr_z": {
        "description": "静息心率 z 阈值",
        "type": "float",
        "default": 2.0,
        "hint": "越高越不敏感，默认 2.0。"
      },
      "rule_sleep_low": {
        "description": "检测睡眠不足",
        "type": "bool",
        "default": true,
        "hint": "需要基线。默认开。"
      },
      "sleep_short_min": {
        "description": "比平时少睡多少分钟算不足",
        "type": "int",
        "default": 90,
        "hint": "默认少 90 分钟。"
      },
      "rule_hrv_low": {
        "description": "检测 HRV 偏低",
        "type": "bool",
        "default": false,
        "hint": "需要基线。默认关，避免误报。"
      },
      "hrv_z": {
        "description": "HRV z 阈值",
        "type": "float",
        "default": 1.5,
        "hint": "默认 1.5，越小越敏感。"
      },
      "rule_spo2_low": {
        "description": "检测血氧偏低",
        "type": "bool",
        "default": true,
        "hint": "绝对阈值，不依赖基线。"
      },
      "spo2_threshold": {
        "description": "血氧阈值（%）",
        "type": "int",
        "default": 95,
        "hint": "低于这个值才提醒，默认 95。"
      },
      "hr_spike_enabled": {
        "description": "检测心率骤升",
        "type": "bool",
        "default": false,
        "hint": "默认关，避免活动时误报。"
      },
      "rule_late_night": {
        "description": "检测昨晚熬夜",
        "type": "bool",
        "default": true,
        "hint": "按入睡时间判断。"
      },
      "late_night_bedtime_min": {
        "description": "几点后入睡算熬夜（分钟）",
        "type": "int",
        "default": 30,
        "hint": "默认 00:30 后。填 30 表示 00:30。"
      },
      "rule_late_night_realtime": {
        "description": "深夜实时提醒",
        "type": "bool",
        "default": true,
        "hint": "她此刻还没睡且心率偏高时提醒。"
      },
      "late_night_start_time": {
        "description": "深夜实时开始时间",
        "type": "string",
        "default": "01:00",
        "hint": "格式 HH:MM，默认 01:00。"
      },
      "late_night_end_time": {
        "description": "深夜实时结束时间",
        "type": "string",
        "default": "05:00",
        "hint": "格式 HH:MM，默认 05:00。"
      },
      "late_night_hr_ratio": {
        "description": "夜间心率倍率",
        "type": "float",
        "default": 1.15,
        "hint": "高于静息心率的这个倍数才算偏高。"
      },
      "rule_period_started": {
        "description": "经期开始提醒",
        "type": "bool",
        "default": true,
        "hint": "默认开。"
      },
      "period_daily_care": {
        "description": "经期每日关怀",
        "type": "bool",
        "default": true,
        "hint": "经期期间每天一条；不占每日上限。"
      },
      "period_daily_step_threshold": {
        "description": "经期步数阈值",
        "type": "int",
        "default": 7000,
        "hint": "超过这个步数就提醒她躺下歇着。"
      },
      "rule_period_soon": {
        "description": "经期临近提醒",
        "type": "bool",
        "default": true,
        "hint": "默认开。"
      },
      "period_soon_days": {
        "description": "提前几天提醒",
        "type": "int",
        "default": 2,
        "hint": "距预测经期还剩几天内提醒。"
      },
      "period_soon_max_stale_days": {
        "description": "数据陈旧上限（天）",
        "type": "int",
        "default": 5,
        "hint": "数据太旧就不提醒，避免经期已到还在说快来了。"
      }
    }
  },
  "chat": {
    "type": "object",
    "description": "聊天关怀",
    "hint": "聊天里顺口关心的强度。",
    "items": {
      "chat_hint_max_items": {
        "description": "每轮最多提几条",
        "type": "int",
        "default": 2,
        "hint": "聊天里最多顺口提几个健康要点。"
      },
      "chat_hint_ttl_hours": {
        "description": "同一要点静默（小时）",
        "type": "float",
        "default": 6.0,
        "hint": "同一件事几小时内不重复提。"
      },
      "chat_hint_dedup_push": {
        "description": "聊天提过就不单独推",
        "type": "bool",
        "default": true,
        "hint": "当天聊天里提过，就不再发主动关怀。"
      }
    }
  },
  "mirror": {
    "type": "object",
    "description": "身体镜像",
    "hint": "沈星回的心率、情绪与数据共振。",
    "items": {
      "mirror_enabled": {
        "description": "启用身体镜像",
        "type": "bool",
        "default": true,
        "hint": "根据对话和健康数据生成沈星回的心率与情绪。"
      },
      "mirror_name": {
        "description": "角色名",
        "type": "string",
        "default": "沈星回",
        "hint": "写进镜像状态里的名字。"
      },
      "mirror_target_umo": {
        "description": "固定目标会话",
        "type": "string",
        "default": "sxh:FriendMessage:3800806724",
        "hint": "插件只在这个会话生效（心跳注入/关怀/主动推送都不碰别的会话）。换会话就改这里，改完重载插件。"
      },
      "mirror_decay_minutes": {
        "description": "心率衰减时长（分钟）",
        "type": "int",
        "default": 25,
        "hint": "情绪过去后心率回落的快慢。"
      },
      "mirror_emotion_gap_minutes": {
        "description": "情绪落点间隔（分钟）",
        "type": "int",
        "default": 5,
        "hint": "两次情绪点之间至少隔多久。"
      },
      "mirror_daily_emotion_points": {
        "description": "每日情绪点上限",
        "type": "int",
        "default": 20,
        "hint": "防止一天写太多点。"
      },
      "mirror_chat_cooldown_minutes": {
        "description": "对话更新冷却（分钟）",
        "type": "int",
        "default": 20,
        "hint": "两次对话改变心率之间至少隔多久。"
      },
      "mirror_auto_rest_hours": {
        "description": "多久没说话自动静息（小时）",
        "type": "int",
        "default": 2,
        "hint": "填 0 关闭自动补点。"
      },
      "mirror_auto_rest_recent_guard_minutes": {
        "description": "静息补点保护窗口（分钟）",
        "type": "int",
        "default": 30,
        "hint": "最近刚有数据就不补，避免打架。"
      },
      "mirror_data_resonance_enabled": {
        "description": "健康数据共振",
        "type": "bool",
        "default": true,
        "hint": "手机上报后更新镜像心率曲线。"
      },
      "mirror_data_whisper_enabled": {
        "description": "允许数据私语",
        "type": "bool",
        "default": false,
        "hint": "默认关。开启后数据共振时可能主动说一句。"
      },
      "mirror_data_debounce_minutes": {
        "description": "数据私语防抖（分钟）",
        "type": "int",
        "default": 15,
        "hint": "两次私语之间至少隔多久。"
      },
      "mirror_data_whisper_cooldown_minutes": {
        "description": "数据私语冷却（分钟）",
        "type": "int",
        "default": 40,
        "hint": "更长的冷却，避免频繁开口。"
      }
    }
  },
  "misc": {
    "type": "object",
    "description": "维护",
    "hint": "日志与数据维护。",
    "items": {
      "care_log_enabled": {
        "description": "保存关怀记录",
        "type": "bool",
        "default": true,
        "hint": "把每次主动关怀写到数据目录，方便事后查看。"
      }
    }
  },
